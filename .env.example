# ============================================================
# XTACK XLOCAL — Variáveis de ambiente
# Copia este ficheiro para .env e preenche com os teus dados
# ============================================================

# Supabase — obter em https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sem estas variáveis o app funciona em modo demo (localStorage)

# Firebase Cloud Messaging (notificações push) — ver FIREBASE_SETUP.md.
# Sem estas 7 variáveis a app funciona, mas SEM notificações push.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
